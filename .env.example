# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Leave blank to fall back to local sqlite3 for quick dev.
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:Temmy005%40@localhost:5432/erinayomi
# ---------------------------------------------------------------------------
# Email (order confirmations)
# EMAIL_BACKEND=console prints emails to the terminal - good for dev, no setup needed.
# EMAIL_BACKEND=smtp sends real email - fill in the fields below.
# Gmail example: create an "App Password" at https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Email (order confirmations)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=temitopesunday005@gmail.com
EMAIL_HOST_PASSWORD=sndrgnilekyythox
DEFAULT_FROM_EMAIL=ERINAYOMI <temitopesunday005@gmail.com>

# ---------------------------------------------------------------------------
# Paystack (get from https://dashboard.paystack.com/#/settings/developer)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Cloudinary (optional, recommended for production image hosting)
# ---------------------------------------------------------------------------
USE_CLOUDINARY=False
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---------------------------------------------------------------------------
# Store contact defaults (used to seed Store Settings the first time the app runs)
# All of these are editable later from /admin/ without touching code.
# ---------------------------------------------------------------------------
DEFAULT_STORE_EMAIL=temitopesunday005@gmail.com
DEFAULT_WHATSAPP_NUMBER=+2348108607409

